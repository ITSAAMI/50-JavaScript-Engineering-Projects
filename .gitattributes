# Normalize all text files to LF in the repository, regardless of OS settings.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.woff binary
*.woff2 binary
*.wasm binary
*.zip  binary
*.gz   binary

# Keep lockfiles out of diff noise and language statistics.
package-lock.json linguist-generated=true -diff
